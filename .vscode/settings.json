  "fileHeaderComment.parameter": {
    "*": {
      "commentprefix": "//!",
      "summary": "Describe this crate or module.",
      "details": "Provide the main responsibilities and usage context."
    }
  },

  "fileHeaderComment.template": {
    "*": [
      "${commentprefix} ${summary}",
      "${commentprefix}",
      "${commentprefix} ${details}"
    ]
  },
