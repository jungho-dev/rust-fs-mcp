# codebase-memory-mcp project-local excludes.
# Keep maintained configs, MCP proxies, hooks, skills, agents, and templates indexable.

# Credentials and local identity.
/.env-codex
/.env
/.env.*
/auth.json
/auth/
/cap_sid
/installation_id
*.pem
*.key
*.p12
*.pfx
.codex/
.claude/

# Agent memory, conversation history, and session state.
/.personality_migration
/memories/
/history.jsonl
/session_index.jsonl
/sessions/
/states/
/logs/
*.jsonl
*.log

# Caches, databases, and generated local state.
/cache/
/sqlite/
/models_cache.json
/.tmp/
/tmp/
*.sqlite
*.sqlite-*
*.db
*.db-*
*.wal
*.shm

# Sandboxes and local helper binaries.
/.sandbox/
/.sandbox-bin/
/.sandbox-secrets/
/.playwright/

# Reports, local backups, IDE metadata, and scratch workspaces.
/.docs/
/.base/
/.backup/
/.idea/
/.playground/
**/.base/
**/.backup/
**/.idea/
**/.playground/
*.bak
*.backup
*.orig
*.rej
*.reg

# Dependencies, build output, and generated bytecode.
/node_modules/
/venvs/
/dist/
/build/
/coverage/
/target/
/out/
/.next/
/mcp/bun.lock
**/node_modules/
**/__pycache__/
*.pyc
