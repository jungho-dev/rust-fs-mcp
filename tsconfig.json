{
  "$schema": "https://www.schemastore.org/tsconfig",
  "compilerOptions": {
    "outDir": "./out",
    "paths": {
			"@type/*": ["./src/assets/type/domain/*"],
    },
    "typeRoots": [
			"node_modules/@types",
			"./src/assets/type/dist"
    ],
		"types": [
			"node"
		],
    "lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true
	}
}
